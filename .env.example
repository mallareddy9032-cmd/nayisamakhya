# Supabase — anon key is REQUIRED for /api/feed (RLS) and /api/survey/submit.
# Without NEXT_PUBLIC_SUPABASE_ANON_KEY those routes return 503 (fail closed).
# Mandal hubs fall back to static src/lib/data/mandals.ts if URL/key missing.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role: webhook + admin desks only. Never use on public routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Method 3 — Telegram Live Moderation Desk
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_WEBHOOK_SECRET=random-webhook-secret
# War Room / alert desk chat id (supergroup or channel; usually negative).
# Auto-detect: add bot to group → send a message → npm run setup:telegram
TELEGRAM_CHAT_ID=
# Executive deskDispatch channel (may match TELEGRAM_CHAT_ID)
# TELEGRAM_ADMIN_CHANNEL_ID=
MODERATION_DESK_SECRET=desk-api-secret
NEXT_PUBLIC_SITE_URL=https://www.nayisamakhya.org

# Admin Portal — Milestone 1 cookie session (/admin/login → admin_session)
# Prefer explicit ADMIN_* vars in production (Vercel).
# Fallbacks when unset:
#   PIN  → MODERATION_DESK_SECRET (same credential that unlocks moderation)
#   HMAC → derived from MODERATION_DESK_SECRET | CRON_SECRET | TELEGRAM_WEBHOOK_SECRET
# Local/dev also has safe placeholders — NEVER reuse those placeholders in production.
ADMIN_SECRET_PIN=change-me-local-admin-pin
ADMIN_SESSION_SECRET=change-me-local-session-hmac-secret
# For scripts/setup-method3.mjs (sets Vercel env + redeploy + webhook)
VERCEL_TOKEN=vercel_xxx
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# GitHub — Cloud Agent secret OR gitignored .env.local (never commit real token)
# Fine-grained PAT: Contents Read/Write on mallareddy9032-cmd/nayisamakhya
# Used by: scripts/push-github-main.sh
# GITHUB_TOKEN=github_pat_...

# Module 2 — bulletin cron + district dispatch
# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=cron-shared-secret
# Optional WhatsApp Cloud / BSP webhook for coordinator fan-out
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=
# Set to 1 only when live gov HTML adapters are implemented
# BULLETIN_ENABLE_LIVE_ADAPTERS=0

# Module 4 — multi-tier hub join URLs (optional; placeholders used if unset)
# Also accepted as NEXT_PUBLIC_* for client card embeds
NAYI_TELEGRAM_BROADCAST_URL=https://t.me/NayiSamakhyaBroadcast
NAYI_WHATSAPP_ANNOUNCE_COMMUNITY_URL=https://chat.whatsapp.com/invite/nayi-state-announce-placeholder
NAYI_WA_HUB_SOUTH_URL=https://chat.whatsapp.com/invite/nayi-hub-south-placeholder
NAYI_WA_HUB_NORTH_URL=https://chat.whatsapp.com/invite/nayi-hub-north-placeholder
NAYI_WA_HUB_HYD_URL=https://chat.whatsapp.com/invite/nayi-hub-hyd-placeholder
# Client-facing aliases (preferred for CommunityHubsSection embeds)
NEXT_PUBLIC_WA_HUB_SOUTH=https://chat.whatsapp.com/invite/nayi-hub-south-placeholder
NEXT_PUBLIC_WA_HUB_NORTH=https://chat.whatsapp.com/invite/nayi-hub-north-placeholder
NEXT_PUBLIC_WA_HUB_HYD=https://chat.whatsapp.com/invite/nayi-hub-hyd-placeholder
